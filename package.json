{
  "name": "vite-electron-template",
  "version": "1.3.0",
  "private": true,
  "description": "vite-electron-template",
  "author": "君惜",
  "repository": {
    "type": "git",
    "url": "https://github.com/xinlei3166/vite-electron-template"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "yunque-release --skipBuild",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "dev": "vite --host",
    "build": "vite build",
    "serve": "vite preview",
    "clean": "rm -rf dist/main dist/render",
    "dev:electron": "cross-env NODE_ENV=development electron index.js",
    "tsc:electron": "tsc -p tsconfig.electron.json",
    "build:electron-win": "yarn tsc:electron && electron-builder --win --x64",
    "build:electron-mac": "yarn tsc:electron && electron-builder --mac",
    "build:win": "run-s clean build build:electron-win",
    "build:mac": "run-s clean build build:electron-mac"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/components": "^10.5.0",
    "@vueuse/core": "^10.5.0",
    "animate.css": "^4.1.1",
    "ant-design-vue": "^4.0.6",
    "axios": "^1.5.1",
    "cos-js-sdk-v5": "^1.4.21",
    "dayjs": "^1.11.10",
    "js-cookie": "^3.0.5",
    "mitt": "^3.0.1",
    "nanoid": "^5.0.2",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persist": "^1.0.0",
    "qs": "^6.11.2",
    "sortablejs": "^1.15.2",
    "vue": "^3.3.6",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.5",
    "@types/mockjs": "^1.0.9",
    "@types/node": "^20.8.8",
    "@types/nprogress": "^0.2.2",
    "@types/qs": "^6.9.9",
    "@types/verror": "latest",
    "@unocss/postcss": "^0.57.1",
    "@unocss/preset-rem-to-px": "^0.57.1",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/compiler-sfc": "^3.3.6",
    "@yunquejs/release": "^0.1.9",
    "conventional-changelog-cli": "^4.1.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.2",
    "electron-builder": "^24.6.4",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "lint-staged": "^15.0.2",
    "mockjs": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "picocolors": "latest",
    "postcss": "^8.4.31",
    "simple-git-hooks": "latest",
    "ts-node": "^10.9.1",
    "tsx": "latest",
    "typescript": "^5.2.2",
    "unocss": "^0.57.1",
    "unplugin-auto-import": "^0.16.6",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^5.0.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-style-import": "^2.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false",
    "commit-msg": "pnpm exec tsx scripts/verifyCommit.ts $1"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  },
  "build": {
    "appId": "electron-vue-demo",
    "productName": "electron-vue-demo",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "files": [
      "dist/main/**/*",
      "dist/render/**/*"
    ],
    "directories": {
      "output": "dist/release"
    },
    "electronDownload": {
      "mirror": "https://npm.taobao.org/mirrors/electron/"
    }
  }
}
